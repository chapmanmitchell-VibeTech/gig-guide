{
  "expo": {
    "name": "Gig Guide",
    "slug": "gig-guide",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1A1310",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nz.co.gigguide.app"
    },
    "android": {
      "package": "nz.co.gigguide.app",
      "adaptiveIcon": {
        "backgroundColor": "#1A1310"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1310",
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
